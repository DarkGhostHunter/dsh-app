{
  "name": "dsh-app",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    // Tauri dev runs open a real window; pass the host display through.
    // Remove if you only build/CI inside the container.
    "--network=host"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "forwardPorts": [5173, 1420],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "rustc --version && node --version && pnpm --version && cargo tauri --version"
}
