{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "identifier": "ai.deepseek.harness",
    "publisher": "DarkGhostHunter",
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "active": true
    }
  },
  "tauri": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://api.github.com/repos/DarkGhostHunter/dsh-app/releases/latest"
      ]
    },
    "security": {
      "csp": null
    }
  }
}